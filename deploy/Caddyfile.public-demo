{
    auto_https disable_redirects
}

http://pac.163-176-228-150.sslip.io {
    redir https://pacdigital-mprj.163-176-228-150.sslip.io{uri} permanent
}

https://pac.163-176-228-150.sslip.io {
    redir https://pacdigital-mprj.163-176-228-150.sslip.io{uri} permanent

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Robots-Tag "noindex, nofollow, noarchive"
        Referrer-Policy "no-referrer"
    }
}

http://pacdigital-mprj.163-176-228-150.sslip.io {
    redir https://pacdigital-mprj.163-176-228-150.sslip.io{uri} permanent
}

https://pacdigital-mprj.163-176-228-150.sslip.io {
    encode zstd gzip
    reverse_proxy pac-digital-web:8080

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Robots-Tag "noindex, nofollow, noarchive"
        Referrer-Policy "no-referrer"
    }
}
